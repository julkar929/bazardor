# Required in production (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
# Your deployed URL (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas connection string. If empty, an in-memory store is used (dev only; data resets on restart).
MONGODB_URI=
MONGODB_DB=bazardor

# Optional social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: override product API (default is the assignment API)
BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor
